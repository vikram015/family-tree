{
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "firebase.dev.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/share/**",
        "run": {
          "serviceId": "kinvia-api",
          "region": "asia-south2"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
