{
  "compilerOptions": {
    "target": "es6",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "webworker"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "noFallthroughCasesInSwitch": true,
    // isolatedModules is deliberately OFF: relatives-tree's .d.ts declares
    // Gender/RelType as `declare const enum`, but the package DOES ship real
    // runtime values in lib/types.js. The flag would reject every use of them as
    // an un-inlinable ambient const enum, which is a false positive here.
    "useDefineForClassFields": true,
    "types": [
      "vite/client",
      "vite-plugin-pwa/client"
    ],
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
